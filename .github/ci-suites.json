{
  "suites": {
    "global": {},
    "web": {},
    "cli": {},
    "ios": {},
    "docker": {}
  },
  "rules": [
    { "paths": ["**/*.md", "docs/**", "LICENSE", "cowtail.png"], "suites": [] },
    {
      "paths": [
        ".github/workflows/ci.yml",
        ".github/ci-suites.json",
        ".github/workflows/release.yml",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".node-version",
        ".gitignore"
      ],
      "suites": "*"
    },
    { "paths": ["protocol/**", "protocol/**/.*"], "suites": ["global", "web", "cli", "ios"] },
    { "paths": [".github/actions/setup-ios/**"], "suites": ["ios"] },
    { "paths": [".github/workflows/global-verify.yml"], "suites": ["global"] },
    { "paths": [".github/workflows/web-verify.yml"], "suites": ["web"] },
    { "paths": [".github/workflows/cli-verify.yml", ".github/workflows/cli-build.yml"], "suites": ["cli"] },
    { "paths": [".github/workflows/ios-verify.yml", ".github/workflows/ios-build.yml"], "suites": ["ios"] },
    { "paths": [".github/workflows/docker-verify.yml", ".github/workflows/docker-build.yml"], "suites": ["docker"] },
    {
      "paths": [
        ".github/workflows/convex-deploy.yml",
        ".github/workflows/release-freeze.yml",
        ".github/actionlint.yaml",
        ".codex/**",
        ".githooks/**",
        ".linear-cli-workspace"
      ],
      "suites": []
    },
    { "paths": ["cli/package.json"], "suites": ["global", "cli", "docker"] },
    { "paths": ["web/**", "web/**/.*"], "suites": ["global", "web", "docker"] },
    { "paths": ["cli/**", "cli/**/.*"], "suites": ["global", "cli"] },
    { "paths": ["script/**", ".oxlintrc.json", ".oxfmtrc.json"], "suites": ["global"] },
    { "paths": ["ios/**", "ios/**/.*"], "suites": ["ios"] },
    { "paths": [".dockerignore"], "suites": ["docker"] }
  ]
}
