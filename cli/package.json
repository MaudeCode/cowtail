{
  "name": "@maudecode/cowtail-cli",
  "version": "0.0.0",
  "type": "module",
  "description": "Cowtail CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaudeCode/cowtail.git",
    "directory": "cli"
  },
  "main": "./dist/cowtail.js",
  "bin": {
    "cowtail": "./dist/cowtail.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/config.example.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "node scripts/build.mjs",
    "build:npm": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@maudecode/cowtail-protocol": "workspace:*",
    "@types/node": "^26.6.6",
    "clipanion": "^4.0.0-rc.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
