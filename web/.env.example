# Frontend dev
# The Convex HTTP actions URL `vite dev` proxies /actions to.
COWTAIL_DEV_ACTIONS_URL=https://your-convex-instance.example.site
VITE_ROUNDUP_TIMEZONE=America/New_York

# Convex / server-side URLs used for links and Prometheus fallback
COWTAIL_WEB_ORIGIN=https://cowtail.example.com
SITE_ORIGIN=https://cowtail.example.com
PROMETHEUS_BASE_URL=https://cowtail.example.com/prometheus
# Alertmanager's v2 API as Convex reaches it inside the cluster; maintenance windows silence
# alerts through it. Never route it through the public web origin.
ALERTMANAGER_BASE_URL=http://alertmanager.example:9093
DAILY_ROUNDUP_TIMEZONE=America/New_York
DAILY_ROUNDUP_HOUR_LOCAL=8

# Public iOS association file
UNIVERSAL_LINKS_APP_ID=TEAMID.com.example.cowtail

# APNs / push
APNS_TEAM_ID=TEAMID
APNS_KEY_ID=KEYID12345
APNS_TOPIC=com.example.cowtail
APPLE_AUTH_AUDIENCE=com.example.cowtail

# Optional Pocket ID (OIDC) sign-in: set all four or none. Register a confidential client
# with PKCE and the callback <COWTAIL_WEB_ORIGIN>/actions/api/auth/oidc/callback. The owner's
# subject is that user's ID in Pocket ID; it signs in as COWTAIL_OWNER_USER_ID.
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=cowtail
# OIDC_CLIENT_SECRET=replace-me
# COWTAIL_OWNER_OIDC_SUBJECT=00000000-0000-0000-0000-000000000000
# OIDC_DISPLAY_NAME=Pocket ID

# Optional Sign in with Apple on the web: a Services ID whose primary App ID is the app's,
# with the return URL <COWTAIL_WEB_ORIGIN>/actions/api/auth/apple/callback.
# APPLE_WEB_SERVICES_ID=com.example.cowtail.web
